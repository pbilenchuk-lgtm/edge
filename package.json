{
  "name": "edge-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EDGE LAB — paper-trading platform for AI analysis of live prediction-market bets",
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-sqlite next dev",
    "build": "next build",
    "start": "NODE_OPTIONS=--experimental-sqlite next start",
    "db:seed": "node --experimental-sqlite --import tsx scripts/seed.ts",
    "smoke": "node --experimental-sqlite --import tsx scripts/smoke.ts",
    "pm:probe": "node --import tsx scripts/polymarket-probe.ts",
    "sports:probe": "node --import tsx scripts/sports-probe.ts",
    "simulate": "node --experimental-sqlite --import tsx scripts/simulate.ts",
    "test": "node --experimental-sqlite --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^6.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "playwright-core": "^1.61.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
