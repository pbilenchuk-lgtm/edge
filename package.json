{
  "name": "edge-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EDGE LAB — paper-trading platform for AI analysis of live prediction-market bets",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-sqlite next dev",
    "build": "next build",
    "start": "NODE_OPTIONS=--experimental-sqlite next start",
    "db:seed": "node --experimental-sqlite --import tsx scripts/seed.ts",
    "smoke": "node --experimental-sqlite --import tsx scripts/smoke.ts",
    "pm:probe": "node --import tsx scripts/polymarket-probe.ts",
    "sports:probe": "node --import tsx scripts/sports-probe.ts",
    "sm:probe": "node --import tsx scripts/probe-sportmonks.ts",
    "tsa:probe": "node --import tsx scripts/probe-thestatsapi.ts",
    "coverage:report": "node --import tsx scripts/coverage-report.ts",
    "statpal:probe": "node --import tsx scripts/statpal-coverage.ts",
    "reassess:probe": "node --experimental-sqlite --import tsx scripts/reassess-probe.ts",
    "simulate": "node --experimental-sqlite --import tsx scripts/simulate.ts",
    "sync:once": "node --experimental-sqlite --import tsx scripts/sync-once.ts",
    "tick:once": "node --experimental-sqlite --import tsx scripts/tick.ts",
    "export:log": "node --experimental-sqlite --import tsx scripts/export-match-log.ts",
    "postdeploy:check": "node --experimental-sqlite --import tsx scripts/postdeploy-check.ts",
    "anchor:diagnose": "node --experimental-sqlite --import tsx scripts/anchor-diagnose.ts",
    "complement:audit": "node --experimental-sqlite --import tsx scripts/complement-audit.ts",
    "token2:coverage": "node --experimental-sqlite --import tsx scripts/token2-coverage.ts",
    "void:watch": "node --experimental-sqlite --import tsx scripts/void-watch.ts",
    "melt:report": "node --experimental-sqlite --import tsx scripts/melt-report.ts",
    "matchday": "node --experimental-sqlite --import tsx scripts/matchday.ts",
    "scout:gap": "node --experimental-sqlite --import tsx scripts/scout-gap.ts",
    "poison:count": "node --experimental-sqlite --import tsx scripts/poison-count.ts",
    "shadow:report": "node --experimental-sqlite --import tsx scripts/shadow-report.ts",
    "test": "node --experimental-sqlite --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^6.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "playwright-core": "^1.61.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
