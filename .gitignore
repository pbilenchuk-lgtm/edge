# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# local data (SQLite) — never commit the paper-trading DB
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm

# env — secrets (API keys) live here, never committed (ТЗ §4.6, §9.9)
.env
.env.local
.env*.local

# misc
*.log
.DS_Store
.tsbuildinfo

tsconfig.tsbuildinfo

# preview build artifacts (generated by preview/gen.mjs)
preview/bundle.js
preview/data.json
preview/*.db

# archive — дампы базы НЕ коммитятся: в них лежит таблица provider_keys (ключи внешних API).
# Выгрузки и отчёты в archive/ коммитятся, они секретов не содержат. Решение о том, куда класть
# сам дамп, принимает владелец — см. archive/<дата>/MANIFEST.md.
archive/**/db/*.db
archive/**/db/*.db-wal
archive/**/db/*.db-shm
