# ============================================================
# EDGE LAB — environment configuration
# Copy to .env and fill in. NEVER commit .env (ТЗ §4.6, §9.9):
# API keys live on the backend only, not in the browser or DB.
# ============================================================

# --- SQLite (node:sqlite, built-in) ---
# Path to the local database file. Created on first `npm run db:seed`.
EDGE_DB_PATH=./data/edge.db

# --- LLM providers (only what you use; missing key => provider disabled) ---
# Anthropic (Claude) — recommended default for analysis + strategies.
ANTHROPIC_API_KEY=
# OpenAI
OPENAI_API_KEY=
# Google (Gemini)
GOOGLE_API_KEY=

# --- Polymarket (prediction-market quotes) ---
# No API key is required to READ quotes. These are the public bases.
# Toggle live fetching off in sandboxes where egress is blocked:
# the client then serves the last snapshot (ТЗ §6 "API котировок недоступен").
POLYMARKET_ENABLED=false
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscribe-clob.polymarket.com/ws/market
# Milliseconds before a quote fetch is considered failed and we fall back.
POLYMARKET_TIMEOUT_MS=6000

# --- Sports data (ESPN public API, no key) ---
# Drives match import/categorization + lifecycle. ЧМ-2026 = fifa.world (ядро).
SPORTS_ENABLED=false
ESPN_BASE=https://site.api.espn.com/apis/site/v2/sports
ESPN_SOCCER_LEAGUE=fifa.world
SPORTS_TIMEOUT_MS=8000

# --- Provider snapshot logging (Анализ tab) ---
# Optional per provider. With a key set, collectSnapshots captures the FULL raw
# JSON + extracted labels (xG / shots / stats / lineups / events / odds) for each
# match, pre-match and live — for post-match provider comparison. No key => the
# provider is skipped. (SPORTMONKS_KEY also accepts the name `Sportmonks`.)
SPORTMONKS_KEY=
THESTATSAPI_KEY=
STATPAL_KEY=
# Per-provider fetch timeout for snapshots (falls back to SPORTS_TIMEOUT_MS).
SNAPSHOT_TIMEOUT_MS=8000
# Retention (days) for raw provider snapshots. Long by default — we accrue
# matches to research/build our own models later (~50+). Default 1095 (3 years).
SNAPSHOT_RETENTION_DAYS=1095

# --- Betfair Exchange (price source; split-host) ---
# The Betfair API geo-blocks US IPs, and the main app egresses via a US proxy, so
# the Betfair COLLECTOR (scripts/betfair-collect.ts) runs on a Betfair-allowed
# host (EU/UA/UK) and POSTs snapshots to the main app's ingest endpoint.
# On the MAIN app set only the shared secret (auth for ingest/activeMatchRefs):
BETFAIR_INGEST_TOKEN=
# On the COLLECTOR host set these (+ MAIN_APP_URL + BETFAIR_INGEST_TOKEN):
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
# Client cert for non-interactive login (PEM contents, not paths):
BETFAIR_CERT_PEM=
BETFAIR_KEY_PEM=
# Or skip login with a pre-obtained session token:
BETFAIR_SESSION=
BETFAIR_POLL_SEC=20

# --- Engine (triggers) ---
# Rate limit: at most one reassessment per strategy per N match-minutes (§9.7).
REASSESS_GAP_MIN=5
# Cents move that fires a price_move reassessment.
PRICE_MOVE_THRESHOLD=5
